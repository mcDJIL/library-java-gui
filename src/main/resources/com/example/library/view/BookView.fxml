<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.library.controller.BookController">
    <Label text="Katalog Buku" styleClass="page-title" />

    <HBox spacing="15.0" styleClass="card" alignment="CENTER_LEFT">
        <TextField fx:id="txtTitle" promptText="Judul Buku Baru" styleClass="combo-box" HBox.hgrow="ALWAYS" />
        <TextField fx:id="txtStock" promptText="Jumlah Stok" prefWidth="120.0" styleClass="combo-box" />
        <Button mnemonicParsing="false" onAction="#handleAddBook" styleClass="action-btn, btn-success" text="+ Tambah Buku" />
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="bookTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="ID BUKU" />
                <TableColumn fx:id="colTitle" prefWidth="400.0" text="JUDUL BUKU" />
                <TableColumn fx:id="colStock" prefWidth="100.0" text="SISA STOK" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</VBox>