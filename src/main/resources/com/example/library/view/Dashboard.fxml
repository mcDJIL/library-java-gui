<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.library.controller.DashboardController">
    <left>
        <VBox prefWidth="240.0" spacing="10.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding><Insets bottom="30.0" left="20.0" right="20.0" top="30.0" /></padding>
            <Label text="Librarify." styleClass="sidebar-title">
                <VBox.margin><Insets bottom="40.0" /></VBox.margin>
            </Label>
            <Button maxWidth="Infinity" onAction="#showHome" styleClass="sidebar-btn" text="🏠 Beranda" />
            <Button maxWidth="Infinity" onAction="#showTransactions" styleClass="sidebar-btn" text="📦 Transaksi" />
            <Button maxWidth="Infinity" onAction="#showBooks" styleClass="sidebar-btn" text="📚 Data Buku" />
            <Button maxWidth="Infinity" onAction="#showMembers" styleClass="sidebar-btn" text="👥 Data Anggota" />
            <Button maxWidth="Infinity" onAction="#showHistory" styleClass="sidebar-btn" text="🕒 Riwayat" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="main-content" BorderPane.alignment="CENTER">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
        </StackPane>
    </center>
</BorderPane>